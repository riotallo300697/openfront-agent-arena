{
  "name": "openfront-client",
  "scripts": {
    "build-dev": "concurrently \"tsc --noEmit\" \"vite build --mode development\"",
    "build-prod": "concurrently --kill-others-on-fail \"tsc --noEmit\" \"vite build\"",
    "start:client": "vite",
    "start:server": "tsx src/server/Server.ts",
    "start:server-dev": "cross-env GAME_ENV=dev tsx src/server/Server.ts",
    "dev": "cross-env GAME_ENV=dev concurrently \"npm run start:client\" \"npm run start:server-dev\"",
    "dev:staging": "cross-env GAME_ENV=dev API_DOMAIN=api.openfront.dev concurrently \"npm run start:client\" \"npm run start:server-dev\"",
    "dev:prod": "cross-env GAME_ENV=dev API_DOMAIN=api.openfront.io concurrently \"npm run start:client\" \"npm run start:server-dev\"",
    "arena:smoke": "cross-env GAME_ENV=dev tsx arena/runner/src/smoke.ts",
    "arena:local": "cross-env GAME_ENV=dev tsx arena/runner/src/localMatch.ts",
    "arena:config": "cross-env GAME_ENV=dev tsx arena/runner/src/localMatchConfigSmoke.ts",
    "arena:agent-state": "cross-env GAME_ENV=dev tsx arena/runner/src/agentStateAssertionsSmoke.ts",
    "arena:contract": "cross-env GAME_ENV=dev tsx arena/runner/src/agentContractSmoke.ts",
    "arena:action-input": "cross-env GAME_ENV=dev tsx arena/runner/src/agentActionInputSmoke.ts",
    "arena:pipeline": "cross-env GAME_ENV=dev tsx arena/runner/src/agentTurnPipelineSmoke.ts",
    "arena:match-loop": "cross-env GAME_ENV=dev tsx arena/runner/src/matchLoopSmoke.ts",
    "arena:match-result": "cross-env GAME_ENV=dev tsx arena/runner/src/matchResultSmoke.ts",
    "arena:replay-lifecycle": "cross-env GAME_ENV=dev tsx arena/runner/src/replayLifecycleSmoke.ts",
    "arena:replay-reader": "cross-env GAME_ENV=dev tsx arena/runner/src/replayReaderSmoke.ts",
    "arena:http-client": "cross-env GAME_ENV=dev tsx arena/runner/src/httpAgentClientSmoke.ts",
    "arena:http-example": "cross-env GAME_ENV=dev tsx arena/runner/src/httpExampleAgentSmoke.ts",
    "arena:http-example-server": "cross-env GAME_ENV=dev tsx arena/agents/httpExampleAgentLauncher.ts",
    "arena:http-example-server-smoke": "cross-env GAME_ENV=dev tsx arena/agents/httpExampleAgentLauncherSmoke.ts",
    "arena:http-match-config": "cross-env GAME_ENV=dev tsx arena/runner/src/httpMixedMatchConfigSmoke.ts",
    "arena:http-match": "cross-env GAME_ENV=dev tsx arena/runner/src/httpMixedMatchSmoke.ts",
    "arena:validate": "cross-env GAME_ENV=dev tsx arena/runner/src/actionValidationSmoke.ts",
    "arena:observation": "cross-env GAME_ENV=dev tsx arena/runner/src/observationSmoke.ts",
    "arena:intent": "cross-env GAME_ENV=dev tsx arena/runner/src/intentAdapterSmoke.ts",
    "arena:replay": "cross-env GAME_ENV=dev tsx arena/runner/src/replaySmoke.ts",
    "arena:server": "cross-env GAME_ENV=dev tsx arena/server/src/arenaApiServer.ts",
    "arena:postgres-up": "docker compose -f arena/server/docker-compose.postgres.yml up -d",
    "arena:postgres-down": "docker compose -f arena/server/docker-compose.postgres.yml down",
    "arena:postgres-migrate": "cross-env GAME_ENV=dev tsx arena/server/src/arenaPostgresMigrate.ts",
    "arena:postgres-migration-smoke": "cross-env GAME_ENV=dev tsx arena/server/src/arenaPostgresMigrationSmoke.ts",
    "arena:postgres-store-smoke": "cross-env GAME_ENV=dev tsx arena/server/src/arenaPostgresMatchStoreSmoke.ts",
    "arena:server-postgres": "cross-env GAME_ENV=dev ARENA_MATCH_STORE=postgres tsx arena/server/src/arenaApiServer.ts",
    "arena:server-spectator": "cross-env GAME_ENV=dev tsx arena/server/src/arenaApiSpectatorClientExample.ts",
    "arena:server-smoke": "cross-env GAME_ENV=dev tsx arena/server/src/arenaApiServerSmoke.ts",
    "arena:server-store-smoke": "cross-env GAME_ENV=dev tsx arena/server/src/arenaMatchStoreSmoke.ts",
    "arena:server-sessions-smoke": "cross-env GAME_ENV=dev tsx arena/server/src/arenaApiServerSessionsSmoke.ts",
    "arena:server-events-smoke": "cross-env GAME_ENV=dev tsx arena/server/src/arenaApiServerEventsSmoke.ts",
    "arena:sdk-typescript-smoke": "cross-env GAME_ENV=dev tsx arena/sdk/typescript/arenaClientSmoke.ts",
    "arena:sdk-python-smoke": "cross-env GAME_ENV=dev tsx arena/sdk/python/arenaClientSmoke.ts",
    "arena:mcp": "cross-env GAME_ENV=dev tsx arena/mcp/openfront-arena-mcp/src/server.ts",
    "arena:mcp-smoke": "cross-env GAME_ENV=dev tsx arena/mcp/openfront-arena-mcp/src/smoke.ts",
    "arena:check": "npm run arena:config && npm run arena:agent-state && npm run arena:contract && npm run arena:action-input && npm run arena:pipeline && npm run arena:match-loop && npm run arena:match-result && npm run arena:replay-lifecycle && npm run arena:replay-reader && npm run arena:http-client && npm run arena:http-example && npm run arena:http-example-server-smoke && npm run arena:http-match-config && npm run arena:http-match && npm run arena:server-smoke && npm run arena:server-store-smoke && npm run arena:server-sessions-smoke && npm run arena:postgres-migration-smoke && npm run arena:postgres-store-smoke && npm run arena:server-events-smoke && npm run arena:sdk-typescript-smoke && npm run arena:sdk-python-smoke && npm run arena:mcp-smoke && npm run arena:validate && npm run arena:observation && npm run arena:intent && npm run arena:local && npm run arena:replay && npm run arena:smoke",
    "docs:map-generator": "cd map-generator && go doc -cmd -u -all",
    "tunnel": "npm run build-prod && npm run start:server",
    "test": "vitest run && vitest run tests/server",
    "perf": "npx tsx tests/perf/run-all.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --ignore-unknown --write .",
    "format:map-generator": "cd map-generator && go fmt .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "gen-maps": "cd map-generator && go run . && npm run format",
    "inst": "npm ci --ignore-scripts"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix",
      "prettier --ignore-unknown --write"
    ]
  },
  "devDependencies": {
    "@datastructures-js/priority-queue": "^6.3.5",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/benchmark": "^2.1.5",
    "@types/d3": "^7.4.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/hammerjs": "^2.0.46",
    "@types/howler": "^2.2.12",
    "@types/js-yaml": "^4.0.9",
    "@types/msgpack5": "^3.4.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "@types/seedrandom": "^3.0.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "benchmark": "^2.1.4",
    "canvas": "^3.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-gha": "^2.0.1",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "lit": "^3.3.2",
    "lit-markdown": "^1.3.2",
    "mrmime": "^2.0.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.18.1",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sh": "^0.18.1",
    "tailwindcss": "^4.2.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.5",
    "vitest-canvas-mock": "^1.1.4"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.216.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.216.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.216.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.216.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@opentelemetry/winston-transport": "^0.26.0",
    "@types/compression": "^1.8.1",
    "colord": "^2.9.3",
    "colorjs.io": "^0.6.1",
    "compression": "^1.8.1",
    "dompurify": "^3.4.2",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "fastpriorityqueue": "^0.8.0",
    "howler": "^2.2.4",
    "intl-messageformat": "^11.2.3",
    "ip-anonymize": "^0.1.0",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.1",
    "limiter": "^3.0.0",
    "nanoid": "^5.1.11",
    "node-html-parser": "^7.1.0",
    "obscenity": "^0.4.6",
    "seedrandom": "^3.0.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "winston": "^3.19.0",
    "ws": "^8.20.0",
    "zod": "^4.4.2"
  },
  "type": "module"
}
